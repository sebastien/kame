# Expose the inherited test functions to Go's test runner.
#
# Definition-only library for the Kamefile's `go-tests` task. Each `test`
# package below ROOT gets go_tests_test.go (and go_tests_linux_test.go for
# `//go:build linux` sources) running every `func TestX(t *testing.T)` through
# the legacy wrapper. Outputs are gofmt-formatted.

def go-tests root
	for directory in (dirs (joinpath root "**/test"))
		let sources = (filter ([path] (not (ends? "_test.go" path))) (files (joinpath directory "*.go")))
		if (not (empty? sources))
			let units = (map go-test-unit sources)
			let package = (get "package" (nth -1 units))
			(go-test-suite directory package "" "TestGoSuite" (go-test-names "" units))
			(go-test-suite directory package "linux" "TestGoLinuxSuite" (go-test-names "linux" units))

def go-test-suite directory package tag suite names
	if (not (empty? names))
		let output = (joinpath directory (if (blank? tag) "go_tests_test.go" "go_tests_@{tag}_test.go"))
		let header = (if (blank? tag) "" "//go:build @{tag}\n\n")
		let cases = (map ([name] "t.Run(\"@(slice 4 (count name) name)\", func(t *testing.T){@{name}(legacy.Wrap(t))})\n") (sorted names))
		let body = (join "" cases)
		let content = "@{header}// Code generated by `kame go-tests`; DO NOT EDIT.\npackage @{package}\n\nimport (\"testing\"; legacy \"kame/internal/testing\")\n\nfunc @{suite}(t *testing.T) {\n@{body}}\n"
		printf "%s" $content > $output
		gofmt -w $output

(go-test-unit path) = (let [source (text (read path)) lines (split "\n" source)]
  [
    package: (first (filter-out :nil (map (named "package {name:~[A-Za-z0-9_]+}") lines)))
    tag: (if (starts? "//go:build linux" source) "linux" "")
    names: (filter-out :nil (map (named "func {name:~Test[A-Za-z0-9_]+}{~\\(t \\*testing\\.T\\).*}") lines))])

(go-test-names tag units) = (flatmap ([unit] (get "names" unit)) (filter ([unit] (eq? tag (get "tag" unit))) units))

# A callable returning a line's `name` capture for PATTERN, or nil.
(named pattern) = ([line] (let [found (regex-match pattern line)] (if found (capture "name" found) :nil)))
