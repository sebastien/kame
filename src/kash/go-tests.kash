# Expose the inherited test functions to Go's test runner.
#
# Definition-only library for the Kamefile's go-tests task. Each test package
# below ROOT gets go_tests_test.go (and go_tests_linux_test.go for
# //go:build linux sources) running each Test function through the legacy
# wrapper. Outputs are gofmt-formatted.

def go-tests root
	for directory in (dirs ${abspath root}/**/test)
		let sources = filter (path => not (ends? "_test.go" (str path))) (files ${directory}/*.go)
		if (not (empty? sources))
			let units = map go-test-unit sources
			let package = get "package" (nth -1 units)
			(go-test-suite directory package "" "TestGoSuite" (go-test-names "" units))
			(go-test-suite directory package "linux" "TestGoLinuxSuite" (go-test-names "linux" units))

def go-test-suite directory package tag suite names
	if (not (empty? names))
		let output = joinpath directory (if blank? tag then "go_tests_test.go" else "go_tests_${tag}_test.go")
		let header = if blank? tag then "" else "//go:build ${tag}\n\n"
		let cases = map (name => "t.Run(\"${slice 4 (count name) name}\", func(t *testing.T){${name}(legacy.Wrap(t))})\n") (sorted names)
		let body = join "" cases
		let content = "${header}// Code generated by `kame go-tests`; DO NOT EDIT.\npackage ${package}\n\nimport (\"testing\"; legacy \"kame/internal/testing\")\n\nfunc ${suite}(t *testing.T) {\n${body}}\n"
		printf "%s" $content > $output
		gofmt -w $output

def go-test-unit path
	let source = text (read path)
	let lines = split "\n" source
	return {
		package: first (filter-out nil (map (named "package {name:~[A-Za-z0-9_]+}") lines)),
		tag: if starts? "//go:build linux" source then "linux" else "",
		names: filter-out nil (map (named "func {name:~Test[A-Za-z0-9_]+}{~\\(t \\*testing\\.T\\).*}") lines),
	}

def go-test-names tag units = flatmap (unit => get "names" unit) (filter (unit => tag == unit.tag) units)

# Return a callable that extracts the named capture or yields nil on a miss.
def named pattern_text = line => named-match (regex-match (pattern pattern_text) line)
def named-match found = if found then regex-group "name" found else nil
