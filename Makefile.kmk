# =============================================================================
# kame -- Kame build file
# =============================================================================
#
# Kame discovers Makefile.kmk before Makefile. Make forwards goals here.
# File artifacts use content freshness instead of Make's timestamps;
# repeated native or wasm builds are skipped when declared inputs are unchanged.
# `kame --force TARGET` rebuilds anyway.
#
# Recipes are Kash, not a shell. A nonzero command fails the recipe. Overrides
# are Kame configuration: a build does not grant environment reads, so a raw
# `CFLAGS=` export is not consulted. Assignment wins, then the KAME_ prefix,
# then the default:
#   kame wasm WASM_SDK=/path/to/wasi-sdk
#   KAME_WASM_SDK=/path/to/wasi-sdk kame wasm
#   kame dist-release KAME_RELEASE_PUBLIC_KEY=... KAME_RELEASE_SIGNING_KEY=...
#   KAME_RELEASE_PUBLIC_KEY=... kame dist-release
#
# Inspect a change before running it:
#   kame do plan TARGET
#   kame do inputs --depth -1 TARGET
#   kame -n TARGET
# =============================================================================

SHELL = kash

# --- Paths ------------------------------------------------------------------

KAME_DIR = ./src/go/kame
EXAMPLES_DIR = ./examples

# --- Overridable toolchain --------------------------------------------------
#
# Empty means "not set". WASM_CC / WASM_LD follow the resolved SDK unless set
# on their own; they do not replace the SDK directory, which still supplies
# compiler-rt. PLATFORM and RELEASE_* are the KAME_ environment aliases of the
# matching KAME_* assignment names.

CC ?= ""
CFLAGS ?= ""

WASM_SDK ?= ""
WASM_CC ?= ""
WASM_LD ?= ""
WASM_INITIAL_MEMORY ?= ""
WASM_MAX_MEMORY ?= ""
# Optimized evaluator frames must reach the 32-level depth guard before the
# linear-memory stack is exhausted; nested async dispatch also needs headroom.
WASM_STACK_SIZE ?= ""
WASM_INITIAL_MEMORY_DEFAULT = 16777216
WASM_MAX_MEMORY_DEFAULT = 67108864
WASM_STACK_SIZE_DEFAULT = 524288

KAME_PLATFORM ?= ""
PLATFORM ?= ""
KAME_RELEASE_PUBLIC_KEY ?= ""
KAME_RELEASE_SIGNING_KEY ?= ""
KAME_RELEASE_REVISION ?= ""
RELEASE_PUBLIC_KEY ?= ""
RELEASE_SIGNING_KEY ?= ""
RELEASE_REVISION ?= ""

# CLI assignment of the KAME_* name wins; otherwise the KAME_ environment alias.
(configured primary alias) = (if (blank? primary) alias primary)

# --- Source sets ------------------------------------------------------------
#
# Globs are tracked, so adding or removing a source invalidates consumers.
# The version file is named explicitly: it may not exist yet, and its own
# rule is what refreshes it from VERSION.

KAME_SOURCES =
  (files ./src/go/kame/**/*.go ./src/go/kame/**/*.c ./src/go/kame/**/*.h)

KAME_INPUTS =
  (concat
    [
      ./src/go/kame/cmd/kame/version_generated.go
      ./src/go/kame/go.mod
      ./src/go/kame/go.sum
      ./Makefile.kmk]
    (filter-out ./src/go/kame/cmd/kame/version_generated.go KAME_SOURCES))

# Same roots as Makefile's wasm `find`. cmd/ is excluded so a version bump
# does not relink the module. ownership/ is not part of that link set.
WASM_SOURCE_DIRS =
  [
    ./src/go/kame/cli
    ./src/go/kame/core
    ./src/go/kame/diagnostic
    ./src/go/kame/host
    ./src/go/kame/lang
    ./src/go/kame/operations
    ./src/go/kame/plugins
    ./src/go/kame/program
    ./tools/wasm]

WASM_SOURCES =
  (flatmap
    ([root]
      (files (str root "/**/*.go") (str root "/**/*.c") (str root "/**/*.h")))
    WASM_SOURCE_DIRS)

LAUNCHER_SOURCES = (files ./src/go/kame/cmd/kame-launcher/*.go)

# Keep this list aligned with Makefile's -Wl,--export set.
WASM_EXPORTS =
  [
    "kame_wasm_abi_version"
    "kame_wasm_alloc"
    "kame_wasm_free"
    "kame_wasm_event_header"
    "kame_wasm_copy"
    "kame_wasm_cli"
    "kame_wasm_eval_pure"
    "kame_wasm_parse"
    "kame_wasm_format"
    "kame_wasm_eval_source_pure"
    "kame_wasm_declaration_predicate"
    "kame_wasm_instance_create"
    "kame_wasm_instance_free"
    "kame_wasm_source_compile"
    "kame_wasm_register_plugins"
    "kame_wasm_set_source_name"
    "kame_wasm_expression_request"
    "kame_wasm_set_forwarding"
    "kame_wasm_set_directory"
    "kame_wasm_host_set_file"
    "kame_wasm_host_set_env"
    "kame_wasm_target_begin"
    "kame_wasm_watch_begin"
    "kame_wasm_watch_state"
    "kame_wasm_watch_invalidate"
    "kame_wasm_watch_cancel"
    "kame_wasm_prepare"
    "kame_wasm_plan"
    "kame_wasm_graph"
    "kame_wasm_tools"
    "kame_wasm_set_tool_path"
    "kame_wasm_tools_check"
    "kame_wasm_inspection_grant"
    "kame_wasm_target_event"
    "kame_wasm_process_started"
    "kame_wasm_process_stream"
    "kame_wasm_process_terminal"
    "kame_wasm_expression_begin"
    "kame_wasm_expression_cancel"
    "kame_wasm_expression_effect_kind"
    "kame_wasm_expression_effect_length"
    "kame_wasm_expression_effect_copy"
    "kame_wasm_step"
    "kame_wasm_next_event_header"
    "kame_wasm_next_request_kind"
    "kame_wasm_next_request_data_length"
    "kame_wasm_next_request_key_length"
    "kame_wasm_request_key_copy"
    "kame_wasm_next_request_record_length"
    "kame_wasm_request_record_copy"
    "kame_wasm_request_data_copy"
    "kame_wasm_event_payload_copy"
    "kame_wasm_event_discard"
    "kame_wasm_complete_bytes"
    "kame_wasm_complete_text"
    "kame_wasm_complete_nil"
    "kame_wasm_complete_json"
    "kame_wasm_complete_failure"
    "kame_wasm_result_copy"
    "kame_wasm_result_kind"
    "kame_wasm_diagnostic_length"
    "kame_wasm_diagnostic_copy"
    "kame_wasm_instance_diagnostic_length"
    "kame_wasm_instance_diagnostic_copy"
    "kame_wasm_instance_diagnostic_span"]

WASM_EXPORT_FLAGS = (map ([name] (str "-Wl,--export=" name)) WASM_EXPORTS)

