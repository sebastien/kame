# --- Aggregate targets ------------------------------------------------------
#
# With no target, Kame runs `default`. That is Make's first target, `build`.

default : build

build : dist

dist : ./build/kame.debug ./dist/kame

# --- Version metadata -------------------------------------------------------
#
# generate-version.sh rewrites the file only when its content changes.

./src/go/kame/cmd/kame/version_generated.go : ./VERSION ./src/sh/generate-version.sh
	./src/sh/generate-version.sh

version-source : ./src/go/kame/cmd/kame/version_generated.go

# --- Native binaries --------------------------------------------------------
#
# Each artifact embeds its own mode. Shared version metadata stays
# target-independent, so switching modes does not rewrite it.

./build/kame.debug : @{KAME_INPUTS}
	mkdir -p ./build
	cflags = (if (blank? CFLAGS) "-O2" CFLAGS)
	:cwd $KAME_DIR :env (if (blank? CC) (merge) [CC: CC]) :CFLAGS (str cflags " -DKAME_BUILD_MODE_DEBUG") so build -check=warn -o (abspath ./build/kame.debug) ./cmd/kame

./build/kame.sanitize : @{KAME_INPUTS}
	mkdir -p ./build
	cflags = (if (blank? CFLAGS) "-O2" CFLAGS)
	:cwd $KAME_DIR :CC clang :CFLAGS (str cflags " -DKAME_BUILD_MODE_SANITIZE") so build -check=sanitize -panic=abort -o (abspath ./build/kame.sanitize) ./cmd/kame

./dist/kame : @{KAME_INPUTS}
	mkdir -p ./dist
	:cwd $KAME_DIR :env (if (blank? CC) (merge) [CC: CC]) :CFLAGS "-O3 -DKAME_BUILD_MODE_RELEASE" so build -assert=off -panic=exit -o (abspath ./dist/kame) ./cmd/kame

# --- Cosmopolitan / APE -----------------------------------------------------

./build/tools/cosmocc-4.0.2/bin/cosmocc : ./src/sh/provision-cosmocc.sh
	./src/sh/provision-cosmocc.sh ./build/tools/cosmocc-4.0.2

./dist/kame.com : ./build/tools/cosmocc-4.0.2/bin/cosmocc @{KAME_INPUTS}
	mkdir -p ./dist
	:cwd $KAME_DIR :CC (abspath ./build/tools/cosmocc-4.0.2/bin/cosmocc) :CFLAGS "-O3 -s -DKAME_BUILD_MODE_RELEASE -DKAME_RUNTIME_APE" so build -assert=off -panic=exit -o (abspath ./dist/kame.com) ./cmd/kame

./dist/ape-smoke.com : ./tools/platform/ape-smoke.c ./build/tools/cosmocc-4.0.2/bin/cosmocc
	mkdir -p (dirname (first outputs))
	./build/tools/cosmocc-4.0.2/bin/cosmocc -O2 -o (first outputs) (first inputs)

dist-ape : ./dist/kame.com ./dist/ape-smoke.com

# Preserve a host-native CLI under a stable release platform identifier.
# The pattern rule is incremental; `dist-native` picks the host platform.
# Detect it only at runtime, then request the pattern producer via stat.

./dist/native/{platform}/kame : ./dist/kame
	mkdir -p (dirname (first outputs))
	cp (first inputs) (first outputs)
	chmod +x (first outputs)

dist-native : ./dist/kame ./src/sh/platform_id.py
	platform = (if (blank? (configured KAME_PLATFORM PLATFORM)) (strip $(python3 ./src/sh/platform_id.py)) (configured KAME_PLATFORM PLATFORM))
	dest = (joinpath "./dist/native" platform "kame")
	(stat dest)

# --- WebAssembly ------------------------------------------------------------
#
# Kept out of the default dist so a host without the wasi-sdk toolchain can
# still build the native CLI. Link only compiler-rt's math helpers, not
# WASI/libc. Query the SDK clang because the freestanding target has no
# runtime archive of its own.

wasm-translate :
	mkdir -p ./build/wasm/c
	:cwd $KAME_DIR so translate -o ../../../build/wasm/c ./host/wasm

./build/wasm/kame.wasm : @{WASM_SOURCES} ./src/go/kame/go.mod ./src/go/kame/go.sum ./Makefile.kmk
	sdk = (if (blank? WASM_SDK) (str (strip $(mise where asdf:mise-plugins/mise-wasi-sdk)) "/wasi-sdk") WASM_SDK)
	cc = (if (blank? WASM_CC) (str sdk "/bin/clang") WASM_CC)
	ld = (if (blank? WASM_LD) (str sdk "/bin/wasm-ld") WASM_LD)
	stack = (str (if (blank? WASM_STACK_SIZE) WASM_STACK_SIZE_DEFAULT WASM_STACK_SIZE))
	initial = (str (if (blank? WASM_INITIAL_MEMORY) WASM_INITIAL_MEMORY_DEFAULT WASM_INITIAL_MEMORY))
	maxmem = (str (if (blank? WASM_MAX_MEMORY) WASM_MAX_MEMORY_DEFAULT WASM_MAX_MEMORY))
	mkdir -p ./build/wasm/c
	:cwd $KAME_DIR so translate -o ../../../build/wasm/c ./host/wasm
	sdk_cc = (str sdk "/bin/clang")
	builtins = (strip $($sdk_cc -print-libgcc-file-name))
	test -f $builtins
	sources = (files ./build/wasm/c/**/*.c)
	$cc --target=wasm32-unknown-unknown -Oz -fwrapv -ffreestanding -nostdlib \
		-mexception-handling -mllvm -wasm-enable-sjlj \
		-include ./tools/wasm/kame_wasm_panic.h -DSO_HEAP_SIZE=8388608 \
		(str "-fuse-ld=" ld) -I ./build/wasm/c -I ./src/go/kame/host/wasm \
		-Wl,--no-entry -Wl,--export-memory (str "-Wl,-z,stack-size=" stack) \
		(str "-Wl,--initial-memory=" initial) (str "-Wl,--max-memory=" maxmem) \
		$WASM_EXPORT_FLAGS \
		$sources \
		./tools/wasm/kame_wasm_abi.c ./tools/wasm/kame_wasm_jump.c \
		$builtins -o (first outputs)

wasm : ./build/wasm/kame.wasm

dist-wasm : ./dist/kame.wasm ./dist/kame.js

./dist/kame.wasm : ./build/wasm/kame.wasm
	mkdir -p ./dist
	cp (first inputs) (first outputs)

./dist/kame.js : ./src/js/kame.js
	mkdir -p ./dist
	cp (first inputs) (first outputs)

# --- Release staging --------------------------------------------------------
#
# Stage and sign the flat release assets. Never emit an unsigned release.
# Provenance includes a timestamp, so this stays a task rather than a file rule.
# It does not collect native platform artifacts or rewrite package definitions.

dist-release : ./dist/kame.com ./dist/kame.wasm ./dist/kame.js ./VERSION ./src/sh/release_manifest.py
	public_key = (configured KAME_RELEASE_PUBLIC_KEY RELEASE_PUBLIC_KEY)
	signing_key = (configured KAME_RELEASE_SIGNING_KEY RELEASE_SIGNING_KEY)
	git_revision = $(git rev-parse HEAD) ?? "unknown"
	revision = (if (blank? (configured KAME_RELEASE_REVISION RELEASE_REVISION)) (strip git_revision) (configured KAME_RELEASE_REVISION RELEASE_REVISION))
	version = (strip (text (read ./VERSION)))
	if (blank? public_key)
		(fail! "set KAME_RELEASE_PUBLIC_KEY to the release verification key")
	if (blank? signing_key)
		(fail! "set KAME_RELEASE_SIGNING_KEY to the release signing key")
	test -f $public_key
	test -f $signing_key
	rm -rf ./dist/release
	mkdir -p ./dist/release
	cp ./dist/kame.com ./dist/release/kame.com
	cp ./dist/kame.wasm ./dist/release/kame.wasm
	cp ./dist/kame.js ./dist/release/kame.js
	cp ./VERSION ./dist/release/VERSION
	python3 ./src/sh/release_manifest.py --directory ./dist/release --version $version --revision $revision --public-key $public_key --signing-key $signing_key

# Explicitly refresh checked-in package definitions before committing a release.
# Not a file rule: the outputs are tracked source, and release staging must not
# claim them.

package-manifests : ./dist/kame.com ./VERSION ./src/sh/release_package_manifests.py
	version = (strip (text (read ./VERSION)))
	python3 ./src/sh/release_package_manifests.py --directory ./dist --output-directory ./etc --version $version

# --- Windows launcher -------------------------------------------------------
#
# The Go launcher and the copied WASM pair are one group. Make names only the
# .exe; declaring the siblings keeps a deleted kame.js or kame.wasm from looking
# fresh. The .exe zip and the APE copy are the two Windows release artifacts.

./dist/windows/kame.exe ./dist/windows/kame.js ./dist/windows/kame.wasm : @{LAUNCHER_SOURCES} ./dist/kame.js ./dist/kame.wasm ./src/go/kame/go.mod ./src/go/kame/go.sum
	mkdir -p ./dist/windows
	:cwd $KAME_DIR :CGO_ENABLED "0" :GOOS windows :GOARCH amd64 go build -trimpath -o (abspath ./dist/windows/kame.exe) ./cmd/kame-launcher
	cp ./dist/kame.js ./dist/windows/kame.js
	cp ./dist/kame.wasm ./dist/windows/kame.wasm

./dist/kame-windows-x64.zip : ./dist/windows/kame.exe ./dist/windows/kame.js ./dist/windows/kame.wasm
	rm -f (first outputs)
	:cwd ./dist/windows zip -q ../kame-windows-x64.zip kame.exe kame.js kame.wasm

./dist/kame-windows-x64.exe : ./dist/kame.com
	mkdir -p (dirname (first outputs))
	cp (first inputs) (first outputs)

dist-windows : ./dist/kame-windows-x64.zip ./dist/kame-windows-x64.exe

# --- Tests ------------------------------------------------------------------
#
# Bare tasks always run. Do not cache them: a green record is not a reason to
# skip a test, and an input list would not cover the compiler or the host.

test : test-so test-examples test-go test-cli

test-so : ./src/go/kame/cmd/kame/version_generated.go test-native-lifecycle test-native-host
	:cwd $KAME_DIR so test ./...

test-native-lifecycle : ./src/go/kame/cmd/kame/version_generated.go ./tools/native/test-cli-lifecycle.sh
	:CC clang bash ./tools/native/test-cli-lifecycle.sh

test-native-host : ./tools/native/test-host.sh
	:CC clang bash ./tools/native/test-host.sh

test-examples :
	:cwd $EXAMPLES_DIR so test ./...

test-go : ./src/go/kame/cmd/kame/version_generated.go ./build/kame.debug test-native-lifecycle
	:cwd $KAME_DIR :KAME_NATIVE_FORMAT_TEST_BINARY (abspath ./build/kame.debug) :KAME_NATIVE_CLI_TEST_BINARY (abspath ./build/kame.debug) go test ./cmd/kame

test-cli : ./build/kame.debug dist-wasm ./tests/harness.sh
	./tests/harness.sh

test-cli-options : ./build/kame.debug dist-wasm ./tests/T009-17-cli-options.sh
	./tests/T009-17-cli-options.sh

test-presentation : ./build/kame.debug dist-wasm ./tests/T036-01-cli-presentation.sh ./tests/T036-03-cli-presentation-lifecycle.sh ./tests/T036-02-cli-reuse-reasons.sh
	./tests/T036-01-cli-presentation.sh
	./tests/T036-03-cli-presentation-lifecycle.sh
	./tests/T036-02-cli-reuse-reasons.sh

test-inspection : ./build/kame.debug dist-wasm ./tests/T037-01-cli-build-inspection.sh
	./tests/T037-01-cli-build-inspection.sh

test-reuse-reasons : ./build/kame.debug dist-wasm ./tests/T036-02-cli-reuse-reasons.sh
	./tests/T036-02-cli-reuse-reasons.sh

test-all : test test-leaks

test-sanitize : ./src/go/kame/cmd/kame/version_generated.go test-native-lifecycle test-native-host
	:cwd $KAME_DIR :CC clang so test -check=sanitize -panic=abort ./...
	:cwd $EXAMPLES_DIR :CC clang so test -check=sanitize -panic=abort ./...

test-leaks : ./build/kame.sanitize dist-wasm test-native-lifecycle test-native-host
	leak_scripts = (filter-out ./tests/T013-03-meta-binary.sh (files ./tests/T*.sh))
	:cwd $KAME_DIR :CC clang :KAME_NATIVE_FORMAT_TEST_BINARY (abspath ./build/kame.sanitize) :KAME_NATIVE_CLI_TEST_BINARY (abspath ./build/kame.sanitize) go test -asan ./cmd/kame
	:cwd $KAME_DIR :CC clang so test -check=sanitize -panic=abort ./...
	:cwd $EXAMPLES_DIR :CC clang so test -check=sanitize -panic=abort ./...
	:ASAN_OPTIONS "detect_leaks=1:halt_on_error=1" :UBSAN_OPTIONS "halt_on_error=1" :CLI_BIN (abspath ./build/kame.sanitize) ./tests/harness.sh $leak_scripts

wasm-portable : ./src/sh/check-portable.sh
	./src/sh/check-portable.sh

wasm-check : wasm wasm-portable ./tools/native/test-wasm-header.c ./tools/wasm/check-imports.mjs ./tools/wasm/test-abi.mjs
	cc = (if (blank? CC) "cc" CC)
	$cc -std=c11 -Wall -Wextra -Werror -fsyntax-only ./tools/native/test-wasm-header.c
	node ./tools/wasm/check-imports.mjs ./build/wasm/kame.wasm
	node ./tools/wasm/test-abi.mjs ./build/wasm/kame.wasm

# map/run! streams each script and fails the recipe on the first nonzero status.
test-wasm : wasm-check @{TEST_WASM}
	(map ([script] (run! script)) TEST_WASM)

# --- Formatting and cleanup -------------------------------------------------

fmt : ./build/kame.debug
	git ls-files -z -- "*.go" | xargs -0r gofmt -w
	git ls-files -z -- "*.sh" | xargs -0r shfmt -w
	./build/kame.debug do fmt -i Makefile.kmk

clean :
	rm -rf ./build ./dist

demo :
	:cwd ./examples/engine so run ./demo
