      "run-native-cli-tests": {
        "title": "Run native CLI tests explicitly",
        "text": "When verifying changes to the native CLI or interactive Kash tests, build the CLI and set KAME_NATIVE_CLI_TEST_BINARY to its absolute path before running the package tests; otherwise those tests silently skip and a passing plain `go test` is incomplete.",
        "children": [],
