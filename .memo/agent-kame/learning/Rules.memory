      "pty-redraw-assertions": {
        "title": "Assert fresh PTY redraws",
        "text": "When a PTY test asserts the editor's current layout after multiple keys, inspect only a completed redraw beginning at the fresh clear-screen marker (\\x1b[H\\x1b[2J), not all output accumulated since the keys were sent; intermediate redraws can represent transient input states and cause false failures.",
        "children": [],
        "sources": [
