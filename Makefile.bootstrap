# Kame bootstrap Makefile.
#
# Copy this file to `Makefile` (or include it) in a project that wants Kame
# without installing it. The first invocation provisions `./bin/kame`, and every
# requested goal is delegated to it in order.
#
# Spec: docs/spec/015-distribution.md
KAME_VERSION ?= @KAME_VERSION@
KAME_HOME ?=
KAME_RELEASE_URL ?=
KAME ?= ./bin/kame

ifneq ($(KAME_HOME),)
export KAME_HOME
endif
ifneq ($(KAME_RELEASE_URL),)
export KAME_RELEASE_URL
endif

GOALS := $(if $(MAKECMDGOALS),$(MAKECMDGOALS),default)
.PHONY: $(GOALS)

# Provision the launcher once, verifying it against SHA256SUMS before installing.
$(KAME):
	@mkdir -p $(dir $(KAME))
	@base="$${KAME_RELEASE_URL:-https://github.com/sebastien/kame/releases/download/v$(KAME_VERSION)}"; \
	tmp="$(KAME).tmp.$$$$"; sums="$$tmp.SHA256SUMS"; \
	if command -v curl >/dev/null 2>&1; then fetch() { curl -fsSL "$$1" -o "$$2"; }; \
	elif command -v wget >/dev/null 2>&1; then fetch() { wget -q -O "$$2" "$$1"; }; \
	else echo "kame: no downloader (curl or wget)" >&2; exit 1; fi; \
	fetch "$$base/SHA256SUMS" "$$sums" || exit 1; \
	fetch "$$base/bin/kame" "$$tmp" || exit 1; \
	if command -v sha256sum >/dev/null 2>&1; then actual=$$(sha256sum "$$tmp" | cut -d' ' -f1); \
	elif command -v shasum >/dev/null 2>&1; then actual=$$(shasum -a 256 "$$tmp" | cut -d' ' -f1); \
	else echo "kame: no SHA-256 verifier (sha256sum or shasum)" >&2; rm -f "$$tmp" "$$sums"; exit 1; fi; \
	expected=$$(grep -E '  bin/kame$$' "$$sums" | cut -d' ' -f1); \
	if [ -z "$$expected" ] || [ "$$actual" != "$$expected" ]; then \
		echo "kame: checksum mismatch: bin/kame" >&2; rm -f "$$tmp" "$$sums"; exit 1; \
	fi; \
	chmod +x "$$tmp"; mv "$$tmp" "$(KAME)"; rm -f "$$sums"

# Every requested goal is delegated with the delegate's exit status.
$(GOALS): $(KAME)
	@exec $(KAME) $@
