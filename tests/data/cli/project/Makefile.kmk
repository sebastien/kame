# Realistic multi-rule build fixture driven by hermetic POSIX scripts.
SOURCES = (wildcard ./src/*.c)
VERSION = "1.2.3"

default : ./build/app

./build/app : ./build/main.o ./build/util.o
	sh tools/link @> @<

./build/{name}.o : ./src/{name}.c
	echo compile-@> >> ./runs.log
	sh tools/compile @> @<

./build/version.txt : ; [shell: kame]
	(join "" ["version " VERSION])

task bundle : ./build/app
	sh tools/link ./build/bundle.tar @<

task report : ; [shell: kash]
	(out! "sources=@(count SOURCES)\n")

task clean :
	rm -rf ./build
