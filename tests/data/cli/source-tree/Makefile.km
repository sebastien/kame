SOURCE_PATH = ./src/ts/littlemake

SOURCE_FILES = filter (file => not (includes? "/node_modules/" (str file))) (filter (file => not (ends? ".d.ts" (str file))) (files ${SOURCE_PATH}/**/*.ts))
FILE_COUNT = count SOURCE_FILES
manifest = map (file => {path: relpath SOURCE_PATH file, name: first (splitext file)}) SOURCE_FILES
bundle = "Bundle of ${FILE_COUNT} files"

task default : ./default
rule ./default = str FILE_COUNT "\n"
