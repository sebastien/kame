SOURCE_PATH = ./src/ts/littlemake

SOURCE_FILES = (flatmap
  ([dir] (filter
    ([f] (not (includes? "/node_modules/" f)))
    (filter
      ([f] (not (ends? ".d.ts" f)))
      (wildcard (join "" [dir "/**/*.ts"])))))
  (list SOURCE_PATH)
)

FILE_COUNT = (count SOURCE_FILES)

manifest = (map
  ([file] [
    path: (relpath SOURCE_PATH file)
    name: (nth 0 (splitext file))
  ])
  SOURCE_FILES
)

bundle = (apply
  ([files] "Bundle of @(count files) files")
  SOURCE_FILES
)

default:
	printf '%s\n' @(count SOURCE_FILES) > @>
