# Yield and effect fixtures (specs 006 and 007).
./yield.out : ; [shell: kame]
	"declared content"

./dynamic-yield.out : ; [shell: kame]
	(str (count (wildcard ./src/*.c)))

./conflict.out :
	@(yield! "declared")
	echo command

./write.out : ; [shell: kash]
	(write! "./generated.txt" "written payload")
	echo done > @>

task yielded-task : ; [shell: kash]
	(yield! "not allowed")
