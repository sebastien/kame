# Kame core build example
# Demonstrates definitions, expressions, and a default task.

SOURCE_PATH = ./src/ts/littlemake

SOURCE_FILES = (filter
  ([f] (not (includes? "/node_modules/" f)))
  (filter
    ([f] (not (ends? ".d.ts" f)))
    (wildcard (join "" [SOURCE_PATH "/**/*.ts"]))))

FILE_COUNT = (count SOURCE_FILES)

manifest = (map
  ([file] [
    path: (relpath SOURCE_PATH file)
    name: (nth 0 (splitext file))
  ])
  SOURCE_FILES
)

bundle = (([files] "Bundle of @(count files) files") SOURCE_FILES)

default :
	echo @(bundle)
