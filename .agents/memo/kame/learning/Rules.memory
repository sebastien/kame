          "src/js/kame.js"
        ],
        "review": false
      },
      "verify-usage-parser-eof-at-callers": {
        "title": "Test Usage parser EOF at callers",
        "text": "When changing Usage KDL parsing or handling malformed Usage files, test EOF regressions at ParseKDL and through the parse-usage operation. Usage files are read synchronously from Tab, so both parser behavior and the exposed operation path matter.",
        "children": [],
