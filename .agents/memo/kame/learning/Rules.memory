      "preserve-do-kash-unified-runner-alias": {
        "title": "Preserve the do kash runner alias",
        "text": "Keep `kame do kash` as a language-default alias for `kame do run --lang kash` on the shared runner. During CLI changes, exercise the alias through T017-07 on native and WASM.",
        "children": [],
