        ],
        "review": false
      },
      "preserve-path-pattern-subst-discovery": {
        "title": "Preserve PathPattern subjects in pattern substitution",
        "text": "Accept a PathPattern subject in direct and unary pattern-form subst. Resolve it through tracked wildcard discovery under scoped read authority, then apply existing substitution to the resulting list. Keep literal subst and other pattern operations on their documented input contracts. Use T041-01 to check direct and unary parity, resumed replacement reads, empty discovery, and tracked prerequisites.",
        "children": [],
