      "pty-redraw-assertions": {
        "title": "Assert fresh PTY redraws",
        "text": "When a PTY test asserts the editor's current layout after multiple keys, inspect only a completed redraw beginning at the fresh clear-screen marker (\\x1b[H\\x1b[2J), not all output accumulated since the keys were sent; intermediate redraws can represent transient input states and cause false failures.",
        "children": [],
        "sources": [
          "identity==\"kame:observations\" item=k-be77b5ad32ddaa18f66c52173eacb77d571c035445219c8962777d2ef66517e1"
        ],
        "review": false
      },
      "register-host-process-before-async-launch": {
        "title": "Register process requests before asynchronous launch",
        "text": "In the Node WASM host, register the process group under its instance and request ID before the launch path can yield. Cancellation and signal handlers should await group readiness. Resolve readiness on launch failure or completion without a child so control requests can finish. Exercise immediate control after start and check that a second job remains unaffected.",
        "children": [],
        "sources": [
