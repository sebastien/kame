        ],
        "review": false
      },
      "preserve-newline-collection-separators": {
        "title": "Preserve newline collection separators and application boundaries",
        "text": "Accept a newline as an alternative separator for list items and record fields. Commas separate same-line items, while same-line juxtaposition within an item remains application. Keep multiline expressions open in nested parentheses or through explicit, operator, and required conditional continuations. The canonical formatter separates expanded list items with newlines alone. Compact lists and expanded records retain commas. Continue to emit explicit backslashes when wrapping an application at collection depth. When changing collection grammar or formatting, verify both separator forms and that a wrapped application still reparses as one item.",
        "children": [],
        "sources": [
