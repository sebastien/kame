          "src/js/kame.js"
        ],
        "review": false
      },
      "go-first-implementation": {
        "title": "Keep Kame Go-first",
        "text": "Implement Kame against its current Go architecture, not the constraints of its former transpiler; keep current tracked material free of that retired toolchain. The supported targets are native Go with cgo disabled and Go WASI with an explicit host request/completion boundary, as specified in the architecture and test specs.",
        "children": [],
        "sources": [
          "identity==\"kame:observations\" item=k-7aa58badaa81fa0477e6eb4a2bdde840ae736bed085aee91316cab98fefbb56d"
        ],
        "review": false
      },
      "isolate-declaration-captures-in-freshness-tests": {
        "title": "Isolate declaration captures in rule freshness tests",
        "text": "When testing freshness for rules created in declaration blocks, keep the recipe source, target, and ordinary inputs fixed across builds. Change only an input to a declaration-time binding and assert that the rebuilt artifact reflects the new captured value. This exercises the declaration scope signature without relying on cache invalidation from a changed recipe or target.",
        "children": [],
        "sources": [
          "src/go/kame/cmd/kame/execution_native_test.go",
          "src/go/kame/program/declaration_blocks.go",
          "src/go/kame/program/file_context.go",
          "plan-055.md"
        ],
        "review": false
      },
      "isolate-repeated-cli-diagnostics": {
        "title": "Isolate repeated CLI diagnostics",
        "text": "When a CLI diagnostic appears repeatedly during a language-loop investigation, first reduce to one failing target and inspect argv parsing and positional operands before attributing repetition to loop replay; otherwise one invocation may actually run multiple targets and emit one diagnostic per target.",
        "children": [],
        "sources": [
          "identity==\"kame:observations\" item=k-18b955cb15707bcc379dd79b41cd2f2c46f23827434665820a375079e614e0d0"
        ],
        "review": false
      },
      "keep-eval-scratch-out-of-copyable-contexts": {
        "title": "Keep evaluator scratch out of copyable contexts",
        "text": "When reusing evaluator scratch across resumptions, do not store a spare mutable operand slice by value in an idle, copyable eval.Context: copied contexts can alias that spare and corrupt later reentry. Lend an empty pair from the program while in use and return it only after successful pure-operation cleanup. This is guidance for copyable evaluator contexts, not a claim that Programs are generally concurrent.",
        "children": [],
        "sources": [
          "identity==\"kame:observations\" item=k-7d4ffaad1fabbff3cdc9c967f7c8d2ca53348858ff1c1687164c70b826575d02"
        ],
        "review": false
      },
      "keep-generator-suspension-internal": {
        "title": "Keep generator suspension internal",
        "text": "Keep generator suspension internal to the stream runtime. Preserve terminal script-visible outcomes and the existing `.ok` semantics. Use TestGeneratorInvocationState for the suspended state between pulls and T055-01 for the public capture and wait contract.",
        "children": [],
        "sources": [
          "docs/spec/049-process-inspection.md",
          "docs/spec/055-unified-kame-kash-language.md",
