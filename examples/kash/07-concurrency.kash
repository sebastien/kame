#!/usr/bin/env -S kame do kash
let workspace = line $(mktemp -d ./kash-concurrency.XXXXXX)
defer rm -rf $workspace

let first = $&(test -s ./sample.txt)
let second = $&(grep -q hello ./sample.txt)
wait $first
wait $second
let completion = $?(wait $first)
printf "checks complete: %s\n" $completion.status

# The writer joins before cleanup. The reader runs first in LIFO order.
printf "background report\n" > $workspace/report.txt &
defer cat < $workspace/report.txt
