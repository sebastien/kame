#!/usr/bin/env -S kame do kash
let names = ["world", "hello", "hello"]

# The process pipe streams output. The value pipe transforms the list.
printf "%s\n" $...names | sort | uniq
let unique_names = names |> unique |> sorted
printf "%s\n" $...unique_names

# Capture keeps the trailing newline.
let listing = $(printf "%s\n" $...names | sort | uniq)
echo (count listing)

let report = ./report.txt
printf %s $listing > $report
cat < $report
printf "report complete\n" >> $report
