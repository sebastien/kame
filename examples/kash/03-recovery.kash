#!/usr/bin/env -S kame do kash
# Accept the expected nonzero status and continue.
grep -q needle ./sample.txt ?
echo "continued after an accepted non-match"

grep -q needle ./sample.txt || echo "no needle in the sample"
let found = $?(grep -m1 needle ./sample.txt)
let result = (if found.ok then found.value else nil) ?? "no result"
echo $result

let mode = "preview"
if mode == "preview"
	echo "preview only"
elif mode == "check"
	echo "validation only"
else
	no-such-publication-command
if $?(grep -q hello ./sample.txt && test -s ./sample.txt).ok
	echo "sample validated"
match ./notes/intro.txt
	./notes/{name:*}.txt =>
		printf "note=%s\n" $name
	else =>
		echo "not a note"
