#!/usr/bin/env -S kame do kash
# Requires Kame with the Kash runner specified in docs/spec/017-kash.md.
title = "Little publication"
names = ["hello world.txt" "second.txt"]
arguments = ["" "two words" "a; echo surprise"]
(label name) = (uppercase name)

echo $title
printf "[%s]\n" $names
printf "[%s]\n" (map label names)

# Capture is a value; strip explicitly removes its preserved trailing newline.
greeting = $(printf "hello\n")
echo (uppercase (strip greeting))

# Empty arguments and shell-looking text remain data, not executable source.
printf "<%s>\n" $arguments
# Discovery is explicit; a raw *.txt command argument would be literal.
printf "source=%s\n" (wildcard ./sample.txt)
