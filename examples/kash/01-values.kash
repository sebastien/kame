#!/usr/bin/env -S kame do kash
let title = "Little publication"
let names = ["hello world.txt", "second.txt"]
let arguments = ["", "two words", "a; echo surprise"]
def label name = uppercase name
let labels = map label names

echo $title
printf "[%s]\n" $...names
printf "Names: [%s]\n" "${names}"
printf "[%s]\n" $...labels

# Capture keeps trailing newlines. Strip removes surrounding whitespace.
let greeting = $(printf "hello\n")
echo (uppercase (strip greeting))

# Empty and shell-looking arguments stay separate.
printf "<%s>\n" $...arguments
let sources = wildcard (pattern "./sample.txt")
printf "source=%s\n" $...sources
