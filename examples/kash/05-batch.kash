#!/usr/bin/env -S kame do kash
let options =
	parse-args {
		prefix: {names: ["--prefix"], arity: :one, repeat: :reject},
	} args
let prefix =
	if empty? options.options.prefix then "checked" else first options.options.prefix
for name in ["first note", "second note"]
	printf "%s: %s\n" $prefix $name
let workspace = line $(mktemp -d ./kash-batch.XXXXXX)
defer rm -rf $workspace
touch $workspace/pending
# Inspect the queue again after each iteration.
while $?(test -f $workspace/pending).ok
	printf "processed queued item\n"
	rm $workspace/pending
