#!/usr/bin/env -S kame do kash
let prefix = []
let command = [...prefix, "printf", "%s\n"]
$...command "typed argv"

let workspace = line $(mktemp -d ./kash-example.XXXXXX)
defer rm -rf $workspace
let config = {name: "quotes: \" and newline\n", enabled: true}
(write! ${workspace}/config.json (json config))

# An accepted nonzero exit keeps its original status.
let attempt = $?(false ?)
if attempt.state != :completed or attempt.status != 1
	(fail! "unexpected status")
# Collection callbacks run in order.
(map (item => run! "printf" "%s\n" item) ["first", "second"])

# Retry only the chosen transient status. Every attempt is a fresh observation.
def probe workspace
	if $?(test -f $workspace/ready).ok
		return
	touch $workspace/ready
	sh -c 'exit 75'
let completed = false
for attempt_number in [1, 2, 3]
	let result = $?(probe $workspace)
	if result.ok
		set completed = true
		break
	if result.signal != 0 or result.status != 75
		(fail! "non-retryable failure")
if not completed
	(fail! "retry budget exhausted")
printf "recovered\n"

false || printf "fallback\n"
let message = $(printf payload >&out && printf "progress\n" >&err)
printf "captured=%s\n" $message
