# Named and anonymous functions use the same expression language.
def page source = subst ./notes/{name:*}.txt ./public/{name}.txt source
sources = [./notes/world.txt, ./notes/hello.txt, ./notes/hello.txt]
pages = map page sources
ordered = pages |> map str |> unique |> sorted
labels = map (path => uppercase (basename path)) ordered
publication = {pages: ordered, labels}
