# Named functions and anonymous functions use the same expression language.
(page source) = (replace ./notes/{name:*}.txt ./public/{name}.txt source)
sources = [./notes/world.txt ./notes/hello.txt ./notes/hello.txt]
pages = (map sources page)
ordered = (pages | unique | sorted)
labels = (map ordered ([path] (uppercase (basename path))))
publication = [pages: ordered labels: labels]
