# Request publication, title, pages, first-page, or page-summary.
title = "Little publication"
sources = [./notes/hello.txt, ./notes/world.txt]
pages = subst ./notes/{name:*}.txt ./public/{name}.txt sources
first-page = first pages
page-summary = "Pages: ${pages}"
publication = {title, pages, count: count pages}

# This definition is evaluated only if requested.
unused = uppercase 42
