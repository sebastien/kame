# This value program also supplies the rule file's definitions unchanged.
title = "Little publication"
sources = ./notes/*.txt
(page source) = (sub ./notes/{name:*}.txt ./public/{name}.txt source)
pages =
  (if
    (in? ./notes/index.txt sources)
      (fail! "notes/index.txt is reserved for the publication index")
    (map page sources))
publication = [title: title sources: sources pages: pages count: (count pages)]
