# This value program also supplies the build file's definitions.
title = "Little publication"
sources = files ./notes/*.txt
def page source = subst ./notes/{name:*}.txt ./public/{name}.txt source
pages =
	if in? ./notes/index.txt sources then fail! "notes/index.txt is reserved for the publication index" else map page sources
publication = {title, sources, pages, count: count pages}
