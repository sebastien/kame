# Harmless operational examples; all temporary files belong to this invocation.
prefix = []
command = (concat prefix ["printf" "%s\n"])
$...command "typed argv"

# One terminal LF is framing here because mktemp is a line-oriented producer.
created = $(mktemp -d ./kash-example.XXXXXX)
workspace = (if (ends? "\n" created) (slice 0 -1 created) created)
defer rm -rf $workspace

config = [name: "quotes: \" and newline\n" enabled: :true]
(write! (joinpath workspace "config.json") (json config))

# Authored shell only supplies a deterministic exit code for this example.
attempt = (kash """sh -c "exit 1" ?""")
result = (attempt)
(if (and (= result.signal 0) (has? result.status [0 1])) :nil (fail! "unexpected status"))

# Collection callbacks are ordered. Expression statements discard their results.
(map ([item] (run! "printf" "%s\n" item)) ["first" "second"])

# A fixed, authored shell fixture simulates a transient failure. Runtime values
# are passed as argv/cwd, never inserted into shell source. Never use this policy
# for deployments without explicitly establishing that retries are safe.
probe = (kash """:cwd $workspace sh -c "if test -f ready; then exit 0; fi; touch ready; exit 75" ?""")
retried = (reduce ([previous number]
  (if (= previous.status 0) previous
    (if (and (= previous.signal 0) (= previous.status 75))
      (probe)
      (fail! "non-retryable failure")))) [status: 75 signal: 0] [1 2 3])
(if (= retried.status 0) :nil (fail! "retry budget exhausted"))
printf "recovered\n"
