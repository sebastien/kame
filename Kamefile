# --- Aggregate targets ------------------------------------------------------
#
# With no target, Kame runs `default`. That is Make's first target, `build`.

default : build

build : dist

dist : ./build/kame.debug ./dist/kame

# --- Version metadata -------------------------------------------------------
#
# The Makefile bootstrap generates the same file before Kame exists; keep the
# two in sync. The build ID is the checkout's revision, or "unknown".

./src/go/kame/cmd/kame/version_generated.go : ./VERSION
	version = (strip (text (read ./VERSION)))
	if (not (match? "{~[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?}" version))
		(fail! "invalid version in VERSION: @{version}")
	git = (capture! [stdout: :true stderr: :true] :accept-exit [1 128] "git" "rev-parse" "--short=12" "HEAD") ?? [status: 1]
	build_id = (if (success? git) (strip (text git.stdout)) "unknown")
	(yield! "// Code generated from repository/build metadata; DO NOT EDIT.\npackage main\n\nconst version = \"@{version}\"\nconst buildID = \"@{build_id}\"\nconst buildTime = \"development\"\n")

version-source : ./src/go/kame/cmd/kame/version_generated.go

# --- Native binaries --------------------------------------------------------

./build/kame.debug : @{KAME_INPUTS}
	mkdir -p ./build
	:cwd $KAME_DIR :CGO_ENABLED "0" :GOCACHE (abspath ./build/go-cache) go build -ldflags "-X main.artifactMode=debug" -o (abspath ./build/kame.debug) ./cmd/kame

./build/kame.sanitize : @{KAME_INPUTS}
	mkdir -p ./build
	:cwd $KAME_DIR :CGO_ENABLED "0" :GOCACHE (abspath ./build/go-cache) go build -gcflags "all=-d=checkptr=2" -ldflags "-X main.artifactMode=sanitize" -o (abspath ./build/kame.sanitize) ./cmd/kame

./dist/kame : @{KAME_INPUTS}
	mkdir -p ./dist
	:cwd $KAME_DIR :CGO_ENABLED "0" :GOCACHE (abspath ./build/go-cache) go build -trimpath -ldflags "-s -w -X main.artifactMode=release" -o (abspath ./dist/kame) ./cmd/kame

# Cross-compiled release binaries: kame-{linux,darwin}-{x86_64,arm64}.

RELEASE_SYSTEMS =
  [
    Linux: "linux"
    Darwin: "darwin"
    FreeBSD: "freebsd"
    NetBSD: "netbsd"
    OpenBSD: "openbsd"]
RELEASE_ARCHES =
  [x86_64: "x86_64" amd64: "x86_64" aarch64: "arm64" arm64: "arm64"]
GO_ARCHES = [x86_64: "amd64" arm64: "arm64"]

RELEASE_BINARIES =
  [
    ./dist/kame-linux-x86_64
    ./dist/kame-linux-arm64
    ./dist/kame-darwin-x86_64
    ./dist/kame-darwin-arm64]

./dist/kame-{system:~linux|darwin}-{arch:~x86_64|arm64} : @{KAME_INPUTS}
	mkdir -p ./dist
	:cwd $KAME_DIR :CGO_ENABLED "0" :GOOS $system :GOARCH (get arch GO_ARCHES) :GOCACHE (abspath ./build/go-cache) go build -trimpath -ldflags "-s -w -X main.artifactMode=release" -o (abspath (first outputs)) ./cmd/kame

# Preserve a host-native CLI under a stable release platform identifier.
# The pattern rule is incremental; `dist-native` picks the host platform.
# Detect it only at runtime, then request the pattern producer via stat.

./dist/native/{platform}/kame : ./dist/kame
	mkdir -p (dirname (first outputs))
	cp (first inputs) (first outputs)
	chmod +x (first outputs)

dist-native : ./dist/kame
	system = (get (line $(uname -s)) RELEASE_SYSTEMS)
	arch = (get (lowercase (line $(uname -m))) RELEASE_ARCHES)
	detected = (if (and system arch) "@{system}-@{arch}" (fail! "unsupported native release platform: @(line $(uname -s)) @(line $(uname -m))"))
	platform = (if (blank? (configured KAME_PLATFORM PLATFORM)) detected (configured KAME_PLATFORM PLATFORM))
	dest = (joinpath "./dist/native" platform "kame")
	(stat dest)

# --- WebAssembly ------------------------------------------------------------

# Build beside the output, then rename: other CLI processes may be loading it.

./build/wasm/kame.wasm : @{WASM_SOURCES} ./src/go/kame/go.mod ./Kamefile
	mkdir -p ./build/wasm
	let staged = (line $(mktemp ./build/wasm/.kame.wasm.XXXXXX))
	defer rm -f $staged
	:cwd $KAME_DIR :CGO_ENABLED "0" :GOOS wasip1 :GOARCH wasm :GOCACHE (abspath ./build/go-cache) go build -buildmode=c-shared -o (abspath staged) ./cmd/kame-wasm
	mv $staged ./build/wasm/kame.wasm

wasm : ./build/wasm/kame.wasm

dist-wasm : ./dist/kame.wasm ./dist/kame.js

# Publish the pair by atomic renames, as other CLI processes may be loading it.

./dist/kame.wasm ./dist/kame.js : ./build/wasm/kame.wasm ./src/js/kame.js
	mkdir -p ./dist
	let wasm = (line $(mktemp ./dist/.kame.wasm.XXXXXX))
	let js = (line $(mktemp ./dist/.kame.js.XXXXXX))
	defer rm -f $wasm $js
	cp ./build/wasm/kame.wasm $wasm
	cp ./src/js/kame.js $js
	chmod 644 $wasm $js
	mv $wasm ./dist/kame.wasm
	mv $js ./dist/kame.js

# --- Release staging --------------------------------------------------------
#
# Stage and sign the flat release assets. Never emit an unsigned release.
# Provenance includes a timestamp, so this stays a task rather than a file rule.
# It does not collect native platform artifacts or rewrite package definitions.

release-assets : dist-wasm @{RELEASE_BINARIES} ./dist/kame-windows-x64.zip

dist-release : release-assets ./VERSION ./src/kash/release.kash
	public_key = (configured KAME_RELEASE_PUBLIC_KEY RELEASE_PUBLIC_KEY)
	signing_key = (configured KAME_RELEASE_SIGNING_KEY RELEASE_SIGNING_KEY)
	git_revision = $(git rev-parse HEAD) ?? "unknown"
	revision = (if (blank? (configured KAME_RELEASE_REVISION RELEASE_REVISION)) (strip git_revision) (configured KAME_RELEASE_REVISION RELEASE_REVISION))
	version = (strip (text (read ./VERSION)))
	if (blank? public_key)
		(fail! "set KAME_RELEASE_PUBLIC_KEY to the release verification key")
	if (blank? signing_key)
		(fail! "set KAME_RELEASE_SIGNING_KEY to the release signing key")
	cp ./VERSION ./dist/VERSION
	(release-manifest "./dist/release" version revision public_key signing_key "./dist")

# Explicitly refresh checked-in package definitions before committing a release.
# Not a file rule: the outputs are tracked source, and release staging must not
# claim them.

package-manifests : release-assets ./VERSION ./src/kash/release.kash ./src/kash/templates/kame.rb ./src/kash/templates/kame.json
	(package-manifests "./dist" "./etc" (strip (text (read ./VERSION))))

# --- Release publication ----------------------------------------------------
#
# `dist-release` only stages and signs. `release` builds the runtime assets,
# then runs the operator script, which verifies or publishes the release
# revision, stages, uploads a draft and publishes it to GitHub and npm. Named
# arguments mirror the script's optional flags; key paths still come from
# KAME_RELEASE_PUBLIC_KEY and KAME_RELEASE_SIGNING_KEY. The target holds the
# project lock, so the script is told the assets are prebuilt and stages them
# without re-entering Kame.

release {repo=} {notes=} : release-assets ./dist/kame ./VERSION ./src/sh/release.sh ./src/kash/release.kash ./src/kash/release-manifest.kash
	flags = (concat
		(if (blank? repo) [] ["--repo" repo])
		(if (blank? notes) [] ["--notes-file" notes]))
	:KAME_RELEASE_PREBUILT "1" :KAME (abspath ./dist/kame) ./src/sh/release.sh $flags

# --- Windows launcher -------------------------------------------------------
#
# The Go launcher and the copied WASM pair are one group. Make names only the
# .exe; declaring the siblings keeps a deleted kame.js or kame.wasm from looking
# fresh. The Windows release bundles the launcher with the WASM pair.

./dist/windows/kame.exe ./dist/windows/kame.js ./dist/windows/kame.wasm ./dist/windows/package.json ./dist/windows/VERSION : @{LAUNCHER_SOURCES} ./dist/kame.js ./dist/kame.wasm ./VERSION ./src/go/kame/go.mod ./src/go/kame/go.sum
	mkdir -p ./dist/windows
	:cwd $KAME_DIR :CGO_ENABLED "0" :GOOS windows :GOARCH amd64 :GOCACHE (abspath ./build/go-cache) go build -trimpath -ldflags "-s -w" -o (abspath ./dist/windows/kame.exe) ./cmd/kame-launcher
	cp ./dist/kame.js ./dist/windows/kame.js
	cp ./dist/kame.wasm ./dist/windows/kame.wasm
	cp ./VERSION ./dist/windows/VERSION
	printf '{"type":"module"}\n' > ./dist/windows/package.json

./dist/kame-windows-x64.zip : ./dist/windows/kame.exe ./dist/windows/kame.js ./dist/windows/kame.wasm ./dist/windows/package.json ./dist/windows/VERSION
	rm -f (first outputs)
	:cwd ./dist/windows zip -q ../kame-windows-x64.zip kame.exe kame.js kame.wasm package.json VERSION

dist-windows : ./dist/kame-windows-x64.zip

